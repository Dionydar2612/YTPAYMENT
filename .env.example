# ==== App ====
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key
SESSION_COOKIE_NAME=session_token
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==== Database ====
# Local docker-compose default. On Render, this is provided by the managed
# Postgres instance — copy its "Internal Database URL" here.
DATABASE_URL=postgresql://expense_user:expense_pass@db:5432/expense_db

# ==== Default admin account (created automatically on first startup) ====
DEFAULT_ADMIN_USERNAME=dada
DEFAULT_ADMIN_PASSWORD=123456

# ==== File storage ====
# local | (future: s3)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# ==== Money rounding ====
CURRENCY_DECIMALS=2
